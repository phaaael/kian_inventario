<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Inventário TI - Kian Iluminação</title>
    <link rel="icon" href="https://kian.com.br/wp-content/themes/kian-site/styles/images/favicon.png">
    <link rel="stylesheet" href="/styles/inventory_allrequests.css">
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>Empréstimos Pendentes:</h1>
            <div class="search-container">
                <form class="search" action="#" method="get">
                    <input type="text" name="searchChar" placeholder="Buscar Registro" value="<%= typeof searchChar !== 'undefined' ? searchChar : '' %>">
                    <button type="submit">Buscar</button>
                </form>
            </div>
        </div>
        <div class="table-container">
            <table class="items-table">
                <thead>
                    <tr>
                        <th>Identificação da Solicitação</th>
                        <th>Responsável pelo Empréstimo</th>
                        <th>Solicitante</th>
                        <th>Saída do Setor</th>
                        <th>Equipamento</th>
                        <th>Código de Identificação</th>
                        <th>Previsão de Entrega</th>
                        <th>Funções</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (actives.length > 0) { %>
                        <% actives.forEach((active, index) => { %>
                            <% if (active.delivered !== 1) { %>
                                <tr data-index="<%= index %>">
                                    <td>#<%= active.id %></td>
                                    <td><%= active.responsible_loan %></td>
                                    <td><%= active.requester %></td>
                                    <td><%= active.exit_sector %></td>
                                    <td><%= active.equipment %></td>
                                    <td><%= active.identification_code %></td>
                                    <td><%= active.delivery_forecast %></td>
                                    <td>
                                        <form action="/inventory/delivered/<%= active.id %>" method="POST">
                                            <button type="submit">Finalizar Empréstimo</button>
                                        </form>
                                    </td>
                                </tr>
                            <% } %>
                        <% }); %>
                    <% } else { %>
                        <tr>
                            <td colspan="9">Nenhuma solicitação encontrada</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
        <a href="/inventory/menu">Voltar</a>
    </div>
</body>
</html>
