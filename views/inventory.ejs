<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Inventário TI - Kian Iluminação</title>
    <link rel="icon" href="https://kian.com.br/wp-content/themes/kian-site/styles/images/favicon.png">
    <link rel="stylesheet" href="/styles/inventory_allrequests.css">
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>Empréstimos Pendentes:</h1>
            <div class="search-container">
                <form class="search" action="/inventory/all_requests" method="get">
                    <select name="searchField" style="margin-right: 10px; margin-bottom: 10px;">
                        <option value="id">Identificação da Solicitação</option>
                        <option value="responsavel_emprestimo">Responsável pelo Empréstimo</option>
                        <option value="solicitante">Solicitante</option>
                        <option value="equipamento">Equipamento</option>
                        <option value="codigo_identificacao">Código de Identificação</option>
                        <option value="finalizacao_emprestimo">Solicitação finalizada por</option>
                    </select>
                    <input type="text" name="searchChar" placeholder="Buscar Registro" value="<%= typeof searchChar !== 'undefined' ? searchChar : '' %>" style="margin-right: 10px; margin-bottom: 10px;">
                    <label for="startDate" style="margin-right: 5px; margin-bottom: 10px;">Data de Início:</label>
                    <input type="date" id="startDate" name="startDate" style="margin-right: 10px; margin-bottom: 10px;">
                    <label for="endDate" style="margin-right: 5px; margin-bottom: 10px;">Data de Término:</label>
                    <input type="date" id="endDate" name="endDate" style="margin-right: 10px; margin-bottom: 10px;">
                    <button type="submit" style="margin-bottom: 10px;">Buscar</button>
                </form>
            </div>            
        </div>
        <div class="table-container">
            <table class="items-table">
                <thead>
                    <tr>
                        <th>Identificação da Solicitação</th>
                        <th>Responsável pelo Empréstimo</th>
                        <th>Solicitante</th>
                        <th>Saída do Setor</th>
                        <th>Equipamento</th>
                        <th>Código de Identificação</th>
                        <th>Previsão de Entrega</th>
                        <th>Finalizar Empréstimo</th>
                        <th>Alterar Empréstimo</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (actives && actives.length > 0) { %>
                        <% const filteredActives = actives.filter(active => active.delivered !== 1); %>
                        <% if (filteredActives.length > 0) { %>
                            <% filteredActives.forEach((active, index) => { %>
                                <tr data-index="<%= index %>">
                                    <td>#<%= active.id %></td>
                                    <td><%= active.responsible_loan %></td>
                                    <td><%= active.requester %></td>
                                    <td><%= active.exit_sector %></td>
                                    <td><%= active.equipment %></td>
                                    <td><%= active.identification_code %></td>
                                    <td><%= active.delivery_forecast %></td>
                                    <td>
                                        <form action="/inventory/delivered/<%= active.id %>" method="POST">
                                            <button class="finish" type="submit">❌</button>
                                        </form>
                                    </td>
                                    <td>
                                        <form action="/inventory/change/<%= active.id %>" method="POST">
                                            <button class="alter" type="submit">⚙️</button>
                                        </form>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="9">Nenhuma solicitação encontrada</td>
                            </tr>
                        <% } %>
                    <% } else { %>
                        <tr>
                            <td colspan="9">Nenhuma solicitação encontrada</td>
                        </tr>
                    <% } %>
                </tbody>                      
            </table>
        </div>
        <a href="/inventory/menu">Voltar</a>
    </div>
</body>
</html>
