<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Inventário TI - Kian Iluminação</title>
    <link rel="icon" href="https://kian.com.br/wp-content/themes/kian-site/styles/images/favicon.png">

    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@500&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="/styles/inventory_requests.css">
    <link rel="stylesheet" href="/styles/alert.css">
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>Solicitações Pendentes de Equipamentos:</h1>          
            <div class="search-container">

                <form class="search" action="/inventory/requests" method="get">
                    <select name="searchField" style="cursor: pointer; margin-right: 10px; margin-bottom: 10px;">
                        <option value="id">Identificação da Solicitação</option>
                        <option value="solicitante">Solicitante</option>
                        <option value="equipamento">Equipamento</option>
                        <option value="codigo_identificacao">Código de Identificação</option>
                    </select>
                    <input type="text" name="searchChar" placeholder="Buscar Registro" value="<%= typeof searchChar !== 'undefined' ? searchChar : '' %>" style="margin-right: 10px; margin-bottom: 10px;">
                    <label for="startDate" style="margin-right: 5px; margin-bottom: 10px;">Data de Início:</label>
                    <input type="date" id="startDate" name="startDate" style="cursor: pointer; margin-right: 10px; margin-bottom: 10px;">
                    <label for="endDate" style="margin-right: 5px; margin-bottom: 10px;">Data de Término:</label>
                    <input type="date" id="endDate" name="endDate" style="cursor: pointer; margin-right: 10px; margin-bottom: 10px;">
                    <button type="submit" style="margin-bottom: 10px;">Buscar</button>
                </form>
            </div>            
        </div>
        <div class="table-container">
            <table class="items-table">
                <thead>
                    <tr>
                        <th>Identificação da Solicitação</th>
                        <th>Solicitante</th>
                        <th>Data da Requisição</th>
                        <th>Equipamento</th>
                        <th>Código de Identificação</th>
                        <th>Previsão de Entrega</th>
                        <th>Motivo da Solicitação</th>
                        <th>Aceitar Solicitação</th>
                        <th>Recusar Solicitação</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (actives && actives.length > 0) { %>
                        <% const filteredActives = actives.filter(active => active.request_status !== 1); %>
                        <% if (filteredActives.length > 0) { %>
                            <% filteredActives.forEach((active, index) => { %>
                                <tr data-index="<%= index %>">
                                    <td>#<%= active.id %></td>
                                    <td><%= active.requester %></td>
                                    <td><%= active.exit_sector %></td>
                                    <td><%= active.equipment %></td>
                                    <td><%= active.identification_code %></td>
                                    <td><%= active.delivery_forecast %></td>
                                    <td>
                                        <span class="loan_reason" style="cursor: pointer; font-weight: bold;" onclick="showAlert('<%= active.loan_reason %>')">Exibir Motivo</span>
                                    </td>
                                    <td>
                                        <form action="/inventory/accept/<%= active.id %>" method="POST">
                                            <button style="cursor: pointer; background-color: transparent; font-size: 20px;" class="accept" type="button" onclick="handleRequest('<%= active.id %>', 'accept')">✔️</button>
                                        </form>
                                    </td>
                                    <td>
                                        <form action="/inventory/refuse/<%= active.id %>" method="POST">
                                            <button style="cursor: pointer; background-color: transparent; font-size: 20px;" class="refuse" type="button" onclick="handleRequest('<%= active.id %>', 'refuse')">❌</button>
                                        </form>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="9">Nenhuma solicitação encontrada</td>
                            </tr>
                        <% } %>
                    <% } else { %>
                        <tr>
                            <td colspan="9">Nenhuma solicitação encontrada</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
        <a href="/inventory/menu">Voltar</a>

        <script src="https://unpkg.com/sweetalert/dist/sweetalert.min.js"></script>
        <script src="/scripts/requests.js"></script>
    </body>
</html>