<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Inventário TI - Kian Iluminação</title>

    <link rel="icon" href="https://kian.com.br/wp-content/themes/kian-site/styles/images/favicon.png">

    <link rel="stylesheet" href="/styles/inventory.css">
</head>

<body>

    <section class="container">
        <h1>Gerenciamento de Inventário:</h1><br>
        <form class="login" action="/inventory/management/submit" method="post">
            <input type="text" id="requester" name="requester" placeholder="Solicitante" required>
            <input type="date" id="exit_sector" name="exit_sector" placeholder="Saída do Setor" required>
            <input type="text" id="equipment" name="equipment" placeholder="Equipamento" required>
            <input type="text" id="identification_code" name="identification_code" placeholder="Código de Identificação" required>
            <input type="date" id="delivery_forecast" name="delivery_forecast" placeholder="Previsão de Entrega" required>
        
            <input type="submit" value="Cadastrar">
        </form><br>
        <a href="/inventory/menu">Voltar</a>
    </section>

    
</body>

</html>