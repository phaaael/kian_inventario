<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Menu Principal | Kian</title>
    <link rel="icon" href="https://kian.com.br/wp-content/themes/kian-site/styles/images/favicon.png">

    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@500&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="./styles/functions.css">
</head>
<body>

<section class="container">
    <h1>Menu Principal</h1><br>

    <div class="menu">
        <% if (data.charge === 'Administrador') { %>
            <div class="menu-item" onclick="toggleMenu('admin')">Administração</div>
            <div id="admin" class="submenu">
                <a href="/admin/user-management">Gerenciamento de Usuários</a>
                <a href="/admin/supply-management">Gerenciamento de Suprimentos</a>
                <a href="/admin/equipament-management">Gerenciamento de Equipamentos</a>
            </div>

            <div class="menu-item" onclick="toggleMenu('admin-equip')">Equipamentos</div>
            <div id="admin-equip" class="submenu">
                <a href="/inventory/requests">Requerimentos Pendentes</a>
                <a href="/inventory">Empréstimos Pendentes</a>
                <a href="/inventory/all_requests">Histórico de Requerimentos</a>
                <a href="/inventory/all_loans">Histórico de Empréstimos</a>
            </div>

            <div class="menu-item" onclick="toggleMenu('admin-sup')">Suprimentos</div>
            <div id="admin-sup" class="submenu">
                <a href="/inventory/all_requests_supplements">Requerimentos Pendentes</a>
                <a href="/inventory/all_supplements">Histórico de Requerimentos</a>
            </div>
        <% } %>
        <div class="menu-item" onclick="toggleMenu('user-menu')">Requerimentos</div>
        <div id="user-menu" class="submenu">
            <a href="/inventory/request_loan">Equipamento</a>
            <a href="/inventory/request_supplement">Suprimento</a>
        </div>
    </div>

    <div class="dropdown">
        <button class="dropbtn"><%= data.name %></button>
        <div class="dropdown-content">
            <a href="/inventory/my-requirements">Meus Requerimentos</a>
            <a class="desconectar" href="/inventory/logout">Desconectar-se</a>
        </div>
    </div>
    
</section>

<script src="./scripts/functions.js"></script>

</body>
</html>
