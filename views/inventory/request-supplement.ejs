<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Requerimento | Kian</title>

    <link rel="icon" href="https://kian.com.br/wp-content/themes/kian-site/styles/images/favicon.png">

    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@500&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="./styles/requestsupplement.css">
    <link rel="stylesheet" href="./styles/alert.css">
</head>

<body>

    <section class="container">
        <h1>Requerimento de Suprimento:</h1><br>
        <form class="request_supplement" action="/inventory/request_supplement" method="post">
            <label for="exit_sector">Data da Requisição:</label>
            <input type="date" id="exit_sector" name="exit_sector" required><br>
    
            <label for="supply">Suprimento:</label>
            <select name="item" id="supply" required>
                <option value="">Escolha Suprimento</option>
                <% items.forEach(function(item) { %>
                    <!-- <option value="<%= item.item %>"><%= item.item %> - Estoque: <%= item.qtd_item %></option> -->
                    <option value="<%= item.item %>"><%= item.item %></option>
                <% }); %>
            </select><br> 

            <label for="request_reason">Motivo do Requerimento:</label>
            <input type="text" id="request_reason" name="request_reason" required><br>

            <input class="cadastrar" type="submit" value="Finalizar Requerimento">
        </form>
        <a class="back" href="/inventory/menu">Voltar</a>
    </section>

    <script src="https://unpkg.com/sweetalert/dist/sweetalert.min.js"></script>
    <script src="./scripts/request-supplement.js"></script>
    
</body>

</html>