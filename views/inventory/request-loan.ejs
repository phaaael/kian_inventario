<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Inventário TI - Kian Iluminação</title>

    <link rel="icon" href="https://kian.com.br/wp-content/themes/kian-site/styles/images/favicon.png">

    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@500&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="./styles/requestloan.css">
    <link rel="stylesheet" href="./styles/alert.css">
</head>

<body>

    <section class="container">
        <h1>Solicitação de Equipamento:</h1><br>
        <form class="request_loan" action="/inventory/request_loan" method="post">
            <label for="exit_sector">Data da Requisição:</label>
            <input type="date" id="exit_sector" name="exit_sector" required><br>
    
            <label for="equipment">Equipamento:</label>
            <select name="item" id="equipment" required>
                <option value="">Escolha Equipamento</option>
                <% row.forEach(item => { %>
                    <option value="<%= item.id %>"><%= item.item %> - Identificação: <%= item.codigo_identificacao %></option>
                <% }) %>
            </select><br>            

            <label for="request_reason">Motivo da Solicitação:</label>
            <input type="text" id="request_reason" name="request_reason" required><br>
    
            <label for="delivery_forecast">Previsão de Entrega:</label>
            <input type="date" id="delivery_forecast" name="delivery_forecast" required><br>
            <input class="cadastrar" type="submit" value="Finalizar Solicitação">

        </form>
        <a class="back" href="/inventory/menu">Voltar</a>
    </section>

    <script src="https://unpkg.com/sweetalert/dist/sweetalert.min.js"></script>
    <script src="./scripts/request-loan.js"></script>
    
</body>

</html>