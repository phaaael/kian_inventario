<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kian Inventario - Registrar</title>

    <link rel="stylesheet" href="styles/main.css">
</head>

<body>

    <section class="container">
        <h1><%= data.message %></h1>

        <form class="register" action="/submit/register" method="post">
            <label for="username">Usuario:</label>
            <input type="text" id="username" name="username" required>
            <br>
        
            <label for="password">Senha:</label>
            <input type="password" id="password" name="password" required>
            <br>

            <label for="password_validation">Conforme sua Senha:</label>
            <input type="password" id="password_validation" name="password_validation" required>
            <br>

            <label for="name">Nome:</label>
            <input type="name" id="name" name="name" required>
            <br>

            <label for="surname">Sobrenome:</label>
            <input type="surname" id="surname" name="surname" required>
            <br>
        
            <input type="submit" value="Registrar-se">
        </form>

    </section>
</body>

</html>