<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Inventário TI - Kian Iluminação</title>

    <link rel="icon" href="https://kian.com.br/wp-content/themes/kian-site/styles/images/favicon.png">

    <link rel="stylesheet" href="/styles/inventory.css">
</head>

<body>

    <section class="container">
        <h1>Gerenciamento de Inventário:</h1><br>
        <form class="login" action="/inventory/registration/submit" method="post">
            <label for="requester">Solicitante:</label>
            <input type="text" id="requester" name="requester" required><br>

            <label for="exit_sector">Saída do Setor:</label>
            <input type="date" id="exit_sector" name="exit_sector" required><br>

            <label for="equipment">Equipamento:</label>
            <input type="text" id="equipment" name="equipment" required><br>

            <label for="identification_code">Código de Identificação:</label>
            <input type="text" id="identification_code" name="identification_code" required><br>

            <label for="delivery_forecast">Previsão de Entrega:</label>
            <input type="date" id="delivery_forecast" name="delivery_forecast" placeholder="Previsão de Entrega" required><br>
        
            <input type="submit" value="Cadastrar">
        </form><br>
        <a href="/inventory/menu">Voltar</a>
    </section>

    
</body>

</html>