<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Inventário TI - Kian Iluminação</title>

    <link rel="icon" href="https://kian.com.br/wp-content/themes/kian-site/styles/images/favicon.png">

    <link rel="stylesheet" href="/styles/inventory_registration.css">
    <link rel="stylesheet" href="/styles/alert.css">
</head>

<body>

    <section class="container">
        <h1>Cadastrar Empréstimo:</h1><br>
        <form class="registration" action="/inventory/registration/submit" method="post">
            <label for="responsible_loan">Responsável pelo Empréstimo:</label>
            <input type="text" id="responsible_loan" name="responsible_loan" required><br>

            <label for="requester">Solicitante:</label>
            <input type="text" id="requester" name="requester" required><br>

            <label for="exit_sector">Saída do Setor:</label>
            <input type="date" id="exit_sector" name="exit_sector" required><br>

            <label for="equipment">Equipamento:</label>
            <input type="text" id="equipment" name="equipment" required><br>

            <label for="identification_code">Código de Identificação:</label>
            <input type="text" id="identification_code" name="identification_code" required><br>

            <label for="request_reason">Motivo da Solicitação:</label>
            <input type="text" id="request_reason" name="request_reason" required><br>

            <label for="delivery_forecast">Previsão de Entrega:</label>
            <input type="date" id="delivery_forecast" name="delivery_forecast" placeholder="Previsão de Entrega" required><br>
        
            <input class="cadastrar" type="submit" value="Cadastrar">
        </form>
        <a class="back" href="/inventory/menu">Voltar</a>
    </section>
    
    <script src="https://unpkg.com/sweetalert/dist/sweetalert.min.js"></script>
    <script src="/scripts/registration.js"></script>
</body>

</html>