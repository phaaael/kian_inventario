<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Inventário TI - Kian Iluminação</title>

    <link rel="icon" href="https://kian.com.br/wp-content/themes/kian-site/styles/images/favicon.png">

    <link rel="stylesheet" href="/styles/inventory.css">
</head>

<body>

    <section class="container">
        <h1>Seja Bem-vindo, <%= data.name %> <%= data.surname %> !</h1><br>

        <% if (data.charge === 'Administrador') { %>
            <a href="/inventory">Equipamentos Emprestados</a>
            <a href="/inventory/all_requests">Histórico de Emprestimos</a>
            <a href="/inventory/registration">Emprestar Equipamento</a><br>
        <% } else { %>
            <a href="/inventory">Equipamentos Emprestados</a><br>
        <% } %>

        <a href="/inventory/logout">Desconectar-se</a>
    </section>
</body>

</html>