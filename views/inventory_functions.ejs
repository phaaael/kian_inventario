<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Inventário TI - Kian Iluminação</title>

    <link rel="icon" href="https://kian.com.br/wp-content/themes/kian-site/styles/images/favicon.png">

    <link rel="stylesheet" href="/styles/inventory_functions.css">
</head>

<body>

    <section class="container">
        <h1>Seja Bem-vindo, <%= data.name %> <%= data.surname %> !</h1><br>

        <% if (data.charge === 'Administrador') { %>
            <p>Administração:</p>
            <!-- <a href="/inventory/registration">Cadastrar Empréstimos</a><br> -->
            <a href="/inventory/requests">Solicitações Pendentes</a>
            <a href="/inventory">Empréstimos Pendentes</a>
            <a href="/inventory/all_loans">Histórico de Empréstimos</a>
            <a href="/inventory/all_requests">Histórico de Solicitações</a>

            <p>Funcionários:</p>
            <a href="/inventory/request_loan">Solicitação de Equipamento</a><br>
        <% } else { %>
            <a href="/inventory/request_loan">Solicitação de Equipamento</a><br>
        <% } %>

        <a class="desconectar" href="/inventory/logout">Desconectar-se</a>
    </section>
</body>

</html>