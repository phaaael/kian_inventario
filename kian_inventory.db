CREATE TABLE `kian_usuarios` (
  id INT AUTO_INCREMENT PRIMARY KEY,
  matricula INT NOT NULL UNIQUE,
  usuario VARCHAR(255) NOT NULL UNIQUE,
  senha VARCHAR(255) NOT NULL,
  email VARCHAR(255) NOT NULL,
  nome VARCHAR(255) DEFAULT('Sem Registro'),
  setor VARCHAR(255) NOT NULL,
  cargo VARCHAR(255) DEFAULT('Membro')
);

CREATE TABLE `kian_emprestimos` (
  id INT AUTO_INCREMENT PRIMARY KEY,
  responsavel_emprestimo VARCHAR(255) NOT NULL,
  requerente VARCHAR(255) NOT NULL,
  dt_req DATE NOT NULL,
  equipamento VARCHAR(255) NOT NULL,
  codigo_identificacao VARCHAR(255) NOT NULL,
  motivo VARCHAR(255) NOT NULL,
  previsao_entrega DATE NOT NULL,
  tec_responsavel VARCHAR(255),
  dt_finalizacao DATE,
  entregue BOOLEAN DEFAULT false
);

CREATE TABLE `kian_solicitacoes` (
  id INT AUTO_INCREMENT PRIMARY KEY,
  requerente VARCHAR(255) NOT NULL,
  tipo ENUM('Equipamento', 'Suprimento') NOT NULL,
  dt_req DATE NOT NULL,
  equipamento VARCHAR(255) NOT NULL,
  codigo_identificacao VARCHAR(255),
  motivo VARCHAR(255) NOT NULL,
  motivo_recusa VARCHAR(255),
  previsao_entrega DATE,
  status_solicitacao BOOLEAN DEFAULT false,
  solicitacao_recusada BOOLEAN DEFAULT false,
  tec_responsavel VARCHAR(255),
  dt_finalizacao DATE
);

CREATE TABLE `kian_equipamentos` (
  id INT AUTO_INCREMENT PRIMARY KEY,
  item VARCHAR(255) NOT NULL,
  codigo_identificacao VARCHAR(255) NOT NULL,
  emprestado BOOLEAN DEFAULT false
);

CREATE TABLE `kian_suprimentos` (
  id INT AUTO_INCREMENT PRIMARY KEY,
  item VARCHAR(255) NOT NULL,
  qtd_item INT NOT NULL,
  qtd_critica INT NOT NULL DEFAULT 0
);

CREATE TABLE `kian_reqsuprimentos` (
  id INT AUTO_INCREMENT PRIMARY KEY,
  dt_req DATE NOT NULL,
  suprimento VARCHAR(255) NOT NULL,
  status_entrega BOOLEAN DEFAULT false,
  dt_entrega DATE
);